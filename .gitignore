# Local decompiled Minecraft reference source.
minecraft-mob-system-map/corpus/

# Graphify's generated graph, visualization, manifests, labels, and caches can
# contain hundreds of thousands of lines. Keep them available locally without
# sending them through Git/Codex review. Retain the compact human-readable
# reports as project documentation.
minecraft-mob-system-map/graphify-out/*
!minecraft-mob-system-map/graphify-out/GRAPH_REPORT.md
!minecraft-mob-system-map/graphify-out/GRAPH_HEALTH.txt
zomboid-code-map/corpus/
zomboid-code-map/graphify-out/*
!zomboid-code-map/graphify-out/GRAPH_REPORT.md
!zomboid-code-map/graphify-out/GRAPH_HEALTH.txt
